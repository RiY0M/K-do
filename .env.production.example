# Copy this file to .env on the server and fill it in:
#   cp .env.production.example .env
# Never commit the real .env.

# Domain of the site (without https://). Its DNS "A" record must point to the
# server's IP address before starting, so Caddy can get the HTTPS certificate.
DOMAIN=kdo.example.fr

# Database (only reachable inside Docker)
DB_USER=kdo
DB_PASSWORD=change-me-long-random-password
DB_NAME=kdo

# Signs the login tokens. Generate it with: openssl rand -hex 32
JWT_SECRET=

# Other sites allowed to call the API (comma-separated, with https://).
# Leave empty: the site itself doesn't need it.
CORS_ORIGIN=

# SMTP server for password reset e-mails (Brevo, OVH, Gmail...).
# Port 587 -> SMTP_SECURE=false, port 465 -> SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=K-do <no-reply@kdo.example.fr>
