generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id           String   @id @default(uuid())
    username     String   @unique
    email        String?  @unique
    passwordHash String
    picture      Bytes?
    description  String?
    lastSave     DateTime

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    deletedAt  DateTime?
    lists      List[]
    userLists  UserList[]
    kdos       KDo[]
    userKDos   UserKDo[]

    @@map("users")
}

model List {
    id          String  @id @default(uuid())
    label       String
    description String?
    authorId    String
    position    Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    user       User        @relation(fields: [authorId], references: [id])
    userLists UserList[]
    listKDos  ListKDo[]

    @@map("lists")
}

model UserList {
    id      String @id @default(uuid())
    userId  String
    listId String

    user  User  @relation(fields: [userId], references: [id])
    list List @relation(fields: [listId], references: [id])

    @@map("users_lists")
}

model KDo {
    id        String  @id @default(uuid())
    label     String
    authorId  String
    isChecked Boolean @default(false) // Is checked by author, not by other poeple
    position  Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    user      User       @relation(fields: [authorId], references: [id])
    userKDos  UserKDo[]
    listKDos  ListKDo[]
    links     Link[]

    @@map("k_dos")
}

model UserKDo {
    id     String @id @default(uuid())
    hasChecked Boolean @default(true)
    userId String
    kDoId  String

    user User @relation(fields: [userId], references: [id])
    kDo  KDo  @relation(fields: [kDoId], references: [id])

    @@map("users_k_dos")
}

model ListKDo {
    id      String @id @default(uuid())
    listId  String
    kDoId   String

    list  List @relation(fields: [listId], references: [id])
    kDo   KDo  @relation(fields: [kDoId], references: [id])

    @@map("lists_k_dos")
}

model Link {
    id    String @id @default(uuid())
    kDoId String
    href  String

    kDo KDo @relation(fields: [kDoId], references: [id])

    @@map("links")
}
