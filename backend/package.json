{
  "name": "fastify-backend",
  "version": "1.0.5",
  "author": {
    "name": "R!Y0M"
  },
  "main": "src/server.ts",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test src/test/**/*.test.ts",
    "test:cov": "NODE_ENV=test c8 tsx --test src/test/**/*.test.ts",
    "dev": "nodemon",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/sensible": "^6.0.8",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.6.0",
    "openapi-types": "^12.1.3",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0"
  }
}
